<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                    mc:Ignorable="d">

    <Style TargetType="{x:Type LibraryDetailsView}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type LibraryDetailsView}">
                    <DockPanel d:DesignWidth="1280" d:DesignHeight="960"
                               d:DataContext="{x:Static DesignMainViewModel.DesignIntance}"
                               Margin="0,0,0,0">
                        <Grid DockPanel.Dock="{Settings DetailsListPosition}"
                              Width="{Settings DetailsListWitdh}"
                              Margin="0,0,10,0">
                            <!-- Box -->
                            <Border x:Name="GamesBox" BorderBrush="{DynamicResource PanelSeparatorBrush}"
                                    BorderThickness="1" Background="{DynamicResource NormalBrush}">
                                <ExtendedListBox x:Name="PART_ListGames"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="2,10,2,4"
                                                 ItemContainerStyle="{DynamicResource DetailsViewItemStyle}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.PanningMode="VerticalOnly">
                                    <ExtendedListBox.GroupStyle>
                                        <GroupStyle ContainerStyle="{StaticResource DetailsViewGroupStyle}"/>
                                    </ExtendedListBox.GroupStyle>
                                    <ExtendedListBox.ItemTemplate>
                                        <DataTemplate>
                                            <GameListItem Style="{StaticResource DetailsViewItemTemplate}" />
                                        </DataTemplate>
                                    </ExtendedListBox.ItemTemplate>
                                </ExtendedListBox>
                            </Border>

                            <!-- TUI Label "games" -->
                            <Border Background="{DynamicResource WindowBackgourndBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="12,-7,0,0" Padding="4,0,4,0" IsHitTestVisible="False">
                                <TextBlock x:Name="GamesLabel" Text="games" FontFamily="{DynamicResource FontFamily}" FontSize="11"
                                           Foreground="{DynamicResource TextBrushDarker}" FontWeight="SemiBold" />
                            </Border>

                            <TextBlock FontSize="{StaticResource FontSizeLarge}" Margin="0,15,0,0"
                                       Text="{DynamicResource LOCNoItemsFound}" TextWrapping="Wrap"                                       
                                       TextAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=PART_ListGames, Mode=OneWay}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Grid DockPanel.Dock="Left">
                            <!-- Box -->
                            <Border x:Name="InfoBox" BorderBrush="{DynamicResource PanelSeparatorBrush}"
                                    BorderThickness="1" Background="{DynamicResource NormalBrush}">
                                <DetailsViewGameOverview x:Name="PART_ControlGameView" />
                            </Border>

                            <!-- TUI Label "info" -->
                            <Border Background="{DynamicResource WindowBackgourndBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="12,-7,0,0" Padding="4,0,4,0" IsHitTestVisible="False">
                                <TextBlock x:Name="InfoLabel" Text="info" FontFamily="{DynamicResource FontFamily}" FontSize="11"
                                           Foreground="{DynamicResource TextBrushDarker}" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="GamesBox">
                            <Setter TargetName="GamesBox" Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
                            <Setter TargetName="GamesLabel" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="InfoBox">
                            <Setter TargetName="InfoBox" Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
                            <Setter TargetName="InfoLabel" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>