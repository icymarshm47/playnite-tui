<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">

    <DataTemplate x:Key="TopPanelGeneralViewSettingsTemplate">
        <TextBlock Text="&#xefe2;" FontFamily="{DynamicResource FontIcoFont}" FontSize="16"                   
                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </DataTemplate>

    <DataTemplate x:Key="TopPanelFilterPresetsSelectionTemplate">
        <TextBlock Text="&#xeec0;" FontFamily="{DynamicResource FontIcoFont}" FontSize="18"
                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </DataTemplate>

    <DataTemplate x:Key="TopPanelGroupSettingsTemplate">
        <TextBlock Text="&#xee03;" FontFamily="{DynamicResource FontIcoFont}" FontSize="18"
                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSortSettingsTemplate">
        <TextBlock Text="&#xefee;" FontFamily="{DynamicResource FontIcoFont}" FontSize="18"
                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSwitchDetailsViewTemplate">
        <TextBlock Text="&#xE145;" FontFamily="Segoe UI Symbol" FontSize="16"
                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSwitchGridViewTemplate">
        <TextBlock Text="&#xE138;" FontFamily="Segoe UI Symbol" FontSize="16"
                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSwitchListViewTemplate">
        <TextBlock Text="&#xE14C;" FontFamily="Segoe UI Symbol" FontSize="16"
                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </DataTemplate>
    
    <DataTemplate x:Key="TopPanelUpdateButtonTemplate">
        <TextBlock Foreground="{DynamicResource WarningBrush}"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   Text="&#xef08;" FontSize="20" FontFamily="{DynamicResource FontIcoFont}"/>
    </DataTemplate>

    <DataTemplate x:Key="TopPanelExplorerSwitchTemplate">
        <TextBlock Text="&#xeeed;" FontFamily="{DynamicResource FontIcoFont}" FontSize="18"
                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSelectRandomGameButtonTemplate">
        <TextBlock Text="&#xef03;" FontFamily="{DynamicResource FontIcoFont}" FontSize="18"
                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </DataTemplate>

    <DataTemplate x:Key="TopPanelViewSelectRandomGameButtonTemplate">
        <TextBlock Text="&#xefcf;" FontFamily="{DynamicResource FontIcoFont}" FontSize="18"
                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </DataTemplate>
    
    <DataTemplate x:Key="TopPanelSearchButtonTemplate">
        <TextBlock Text="&#xed12;" FontFamily="{DynamicResource FontIcoFont}" FontSize="18"
                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </DataTemplate>

    <Style x:Key="TopPanelMenu" TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            Grid.IsSharedSizeScope="True">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TopPanelFilterToggle" TargetType="CheckBox">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Height" Value="28" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="6,4,0,4" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="FilterBorder" Background="{TemplateBinding Background}" BorderThickness="1"
                            BorderBrush="{DynamicResource NormalBorderBrush}"
                            CornerRadius="0" Padding="8,2,8,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="#"
                                       FontFamily="{DynamicResource FontFamily}" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentPurpleBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Margin="0,0,4,0"/>
                            <TextBlock Text="{DynamicResource LOCFilters}"
                                       FontFamily="{DynamicResource FontFamily}"
                                       Style="{DynamicResource BaseTextBlockStyle}"
                                       Margin="2,0,0,0" VerticalAlignment="Center"
                                       Name="TextFilter" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{StaticResource True}">
                            <Setter Property="Visibility" Value="Visible" TargetName="TextFilter" />
                            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" TargetName="FilterBorder" />
                            <Setter Property="Background" Value="#FF303030" TargetName="FilterBorder" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource False}">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="TextFilter" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" TargetName="FilterBorder" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TopPanelNotificationsToggle" TargetType="ToggleButton">
        <Setter Property="Margin" Value="6,4,0,4" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Height" Value="28" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Background="{DynamicResource ButtonBackgroundBrush}"
                            BorderBrush="{DynamicResource NormalBorderBrush}"
                            BorderThickness="1" Padding="6,2,6,2">
                        <Grid>
                            <TextBlock Text="&#xeea3;" FontFamily="{DynamicResource FontIcoFont}" FontSize="18"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border CornerRadius="0" Width="14" Height="14"
                                    Margin="14,0,0,0" Background="{DynamicResource AccentPinkBrush}"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <TextBlock Text="{Api Notifications.Count}" FontSize="10"
                                           FontFamily="{DynamicResource FontFamily}" FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrushDark}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TopPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanel}">
                    <Grid Margin="0,0,0,0" d:DesignWidth="1280" d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Border x:Name="TopPanelBox" Height="44"
                                BorderBrush="{DynamicResource PanelSeparatorBrush}"
                                BorderThickness="1"
                                Background="{DynamicResource NormalBrush}">
                            <DockPanel Margin="6,2,110,2">
                                <Border x:Name="PART_ElemMainMenu" Background="Transparent"
                                        DockPanel.Dock="Left" Margin="4,0,8,0" Cursor="Hand"
                                        WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="#" FontFamily="{DynamicResource FontFamily}" FontSize="18"
                                                   FontWeight="Bold" Foreground="{DynamicResource AccentPurpleBrush}"
                                                   VerticalAlignment="Center" Margin="4,0,4,0"/>
                                        <TextBlock Text="playnite" FontFamily="{DynamicResource FontFamily}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    </StackPanel>
                                </Border>

                                <SearchBox x:Name="PART_TextMainSearch"
                                            Margin="4,4,0,4" DockPanel.Dock="Left"
                                            WindowChrome.IsHitTestVisibleInChrome="True"
                                            Width="260" />

                                <StackPanel x:Name="PART_PanelMainItems" Orientation="Horizontal"
                                            VerticalAlignment="Stretch" Margin="6,4,0,4"/>

                                <CheckBox x:Name="PART_ToggleFilter" ToolTip="{DynamicResource LOCFilters}"
                                          Style="{DynamicResource TopPanelFilterToggle}"
                                          DockPanel.Dock="Left" />

                                <CheckBox x:Name="PART_ToggleNotifications"
                                          Style="{DynamicResource TopPanelNotificationsToggle}"
                                          DockPanel.Dock="Left" />

                                <StackPanel x:Name="PART_PanelMainPluginItems" Orientation="Horizontal"
                                            VerticalAlignment="Stretch" Margin="10,4,10,4"
                                            DockPanel.Dock="{Settings PluginTopPanelAlignment}"/>

                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"
                                            HorizontalAlignment="Center" Margin="0,4,0,4">
                                    <Grid MaxWidth="400" MinWidth="200">
                                        <ProgressBar Name="PART_ProgressGlobal" Height="14" />
                                        <TextBlock Name="PART_TextProgressText"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   Style="{DynamicResource BaseTextBlockStyle}" Margin="5,0,5,0" />
                                    </Grid>

                                    <Button Name="PART_ButtonProgressCancel"
                                            Content="{DynamicResource LOCCancelLabel}"
                                            WindowChrome.IsHitTestVisibleInChrome="True"
                                            Margin="5,0,0,0" />
                                </StackPanel>                    
                            </DockPanel>
                        </Border>

                        <!-- TUI Label "menu" sitting on top border line -->
                        <Border Background="{DynamicResource WindowBackgourndBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="12,-7,0,0" Padding="4,0,4,0" IsHitTestVisible="False">
                            <TextBlock x:Name="TopPanelLabel" Text="menu" FontFamily="{DynamicResource FontFamily}" FontSize="11"
                                       Foreground="{DynamicResource TextBrushDarker}" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TopPanelBox" Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
                            <Setter TargetName="TopPanelLabel" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>