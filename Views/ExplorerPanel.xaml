<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                    mc:Ignorable="d">    

    <Style TargetType="{x:Type ExplorerPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ExplorerPanel}">
                    <Grid Margin="0,0,10,0" d:DesignWidth="200" d:DesignHeight="400">
                        <Border x:Name="ExplorerBox" BorderThickness="1" BorderBrush="{DynamicResource PanelSeparatorBrush}"
                                Background="{DynamicResource NormalBrush}">
                            <DockPanel Background="Transparent" Margin="0,10,0,4">
                                <DockPanel DockPanel.Dock="Top" LastChildFill="True"
                                           Margin="6,4,6,8">
                                    <Button Content="r" FontFamily="Marlett"
                                            Style="{StaticResource SimpleButton}"
                                            DockPanel.Dock="Right" Margin="0,0,4,0"
                                            VerticalAlignment="Center"
                                            Name="PART_ButtonClose"/>
                                    <ComboBox Name="PART_SelectFields" MaxDropDownHeight="Auto"
                                              DockPanel.Dock="Left" Margin="0,0,8,0" />
                                </DockPanel>
                                <ListBox Name="PART_SelectItems"
                                         DockPanel.Dock="Top" Margin="4,0,4,8"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- TUI Label "explorer" sitting on top border line -->
                        <Border Background="{DynamicResource WindowBackgourndBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="12,-7,0,0" Padding="4,0,4,0" IsHitTestVisible="False">
                            <TextBlock x:Name="ExplorerLabel" Text="explorer" FontFamily="{DynamicResource FontFamily}" FontSize="11"
                                       Foreground="{DynamicResource TextBrushDarker}" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="ExplorerBox">
                            <Setter TargetName="ExplorerBox" Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
                            <Setter TargetName="ExplorerLabel" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>