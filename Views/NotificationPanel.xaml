<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                    mc:Ignorable="d">

    <Style TargetType="{x:Type NotificationPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="NotificationPanel">
                    <Grid Margin="10,10,10,10" d:DesignWidth="260" d:DesignHeight="400"
                          d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Border x:Name="NotifBox" BorderBrush="{DynamicResource PanelSeparatorBrush}"
                                BorderThickness="1" Background="{DynamicResource PopupBackgroundBrush}">
                            <DockPanel Background="Transparent" Margin="0,10,0,4">
                                <DockPanel Margin="10,6,8,8" DockPanel.Dock="Top">
                                    <Button Name="PART_ButtonClose" Content="r" FontFamily="Marlett"
                                            Style="{StaticResource SimpleButton}"
                                            DockPanel.Dock="Right" Margin="0,0,4,0" />
                                    <Button Name="PART_ButtonDismissAll" DockPanel.Dock="Left"
                                            HorizontalAlignment="Left"
                                            FontFamily="{DynamicResource FontFamily}"
                                            FontSize="{DynamicResource FontSizeSmall}"
                                            Style="{StaticResource SimpleButton}"
                                            Content="{DynamicResource LOCDismissAll}" />
                                </DockPanel>
                                <ItemsControl Name="PART_ItemsMessages" DockPanel.Dock="Top">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource NotificationMessage}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    <ItemsControl.Template>
                                        <ControlTemplate>
                                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                          VerticalScrollBarVisibility="Auto">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                </ItemsControl>
                            </DockPanel>
                        </Border>

                        <!-- TUI Label "notifications" sitting on top border line -->
                        <Border Background="{DynamicResource WindowBackgourndBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="12,-7,0,0" Padding="4,0,4,0" IsHitTestVisible="False">
                            <TextBlock x:Name="NotifLabel" Text="notifications" FontFamily="{DynamicResource FontFamily}" FontSize="11"
                                       Foreground="{DynamicResource TextBrushDarker}" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>