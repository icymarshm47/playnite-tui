<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                    mc:Ignorable="d">
    
    <Style TargetType="{x:Type Sidebar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Sidebar}">
                    <Grid Margin="10,10,0,10">
                        <Border BorderThickness="1" BorderBrush="{DynamicResource PanelSeparatorBrush}"
                                Background="{DynamicResource NormalBrush}"
                                x:Name="SidebarBox">
                            <DockPanel x:Name="DockContentHolder" Margin="0,10,0,4">                            
                                <Border x:Name="PART_ElemMainMenu" Background="Transparent"
                                        Width="42" Height="42" Margin="0,0,0,8"
                                        DockPanel.Dock="Top" Padding="4" Cursor="Hand"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Image Source="{ThemeFile 'Images/applogo.png'}"
                                           RenderOptions.BitmapScalingMode="Fant" />
                                </Border>

                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                              DockPanel.Dock="Top" CanContentScroll="True"
                                              x:Name="ScrollSidebarItems">
                                    <StackPanel x:Name="PART_PanelSideBarItems" Orientation="Vertical" />
                                </ScrollViewer> 
                            </DockPanel>
                        </Border>

                        <!-- TUI Label "nav" sitting on top border line -->
                        <Border Background="{DynamicResource WindowBackgourndBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="6,-7,0,0" Padding="3,0,3,0" IsHitTestVisible="False">
                            <TextBlock x:Name="SidebarLabel" Text="nav" FontFamily="{DynamicResource FontFamily}" FontSize="11"
                                       Foreground="{DynamicResource TextBrushDarker}" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SidebarBox" Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
                            <Setter TargetName="SidebarLabel" Property="Foreground" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Right">
                            <Setter Property="Margin" Value="0,10,10,10" />
                            <Setter Property="Margin" Value="0,10,0,8" TargetName="PART_ElemMainMenu" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                            <Setter Property="Margin" Value="10,10,10,0" />
                            <Setter Property="Margin" Value="4,0,8,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Margin" Value="0,0,100,0" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                        <DataTrigger Binding="{Settings SidebarPosition}" Value="Bottom">
                            <Setter Property="Margin" Value="10,0,10,10" />
                            <Setter Property="Margin" Value="4,0,8,0" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_ElemMainMenu" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="ScrollSidebarItems" />
                            <Setter Property="Orientation" Value="Horizontal" TargetName="PART_PanelSideBarItems" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>